# คัดลอกเป็น .env บนเซิร์ฟเวอร์ (ห้าม commit ไฟล์ .env จริง)
DOCKERHUB_USERNAME=<ชื่อผู้ใช้ Docker Hub>

# พอร์ตที่เปิดบนเซิร์ฟเวอร์ (g19 = 6019)
PUBLIC_PORT=6019

POSTGRES_DB=events_checkin
POSTGRES_APP_USER=postgres
# ใช้ตัวอักษรและตัวเลขเท่านั้น (อยู่ใน URL ของ DATABASE_URL)
POSTGRES_APP_PASSWORD=<รหัสผ่านฐานข้อมูล>

# สร้างด้วย: openssl rand -hex 48
JWT_SECRET=<ค่าสุ่มยาว ๆ>
NO_SHOW_LIMIT=1

OAUTH_CLIENT_ID=<จาก gist>
OAUTH_CLIENT_SECRET=<จาก gist>
OAUTH_REDIRECT_URI=https://fsg19.cpecmu.com/api/auth/callback
FRONTEND_URL=https://fsg19.cpecmu.com
