# ---- Server ----
PORT=4000
# เปิดใน production: NODE_ENV=production (บังคับให้ต้องตั้ง JWT_SECRET)
NODE_ENV=development

# ---- Database ----
POSTGRES_DB=events_checkin
POSTGRES_APP_USER=postgres
POSTGRES_APP_PASSWORD=change_me
POSTGRES_PORT=5432
# ชื่อโฮสต์ DB: localhost ตอนรันบนเครื่อง, ชื่อ service (เช่น postgres) ตอนรันใน Docker
POSTGRES_HOST=localhost
# drizzle-kit (pnpm db:push) ใช้ตัวแปรนี้
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/events_checkin"

# ---- Auth (JWT) ----
# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# รหัสผ่านของผู้ใช้ตัวอย่างตอนรัน seed (ใช้ตอนพัฒนา/สาธิตเท่านั้น)
SEED_PASSWORD=password123

# ---- โควตา/ไม่มาตามรอบ ----
# จำนวนครั้งที่ไม่มาตามรอบ (NO_SHOW) ที่ทำให้จองตั๋วใหม่ไม่ได้ (ค่าเริ่มต้น 1)
NO_SHOW_LIMIT=1

# ---- CMU Mock OAuth ----
# ห้าม commit ค่า secret จริง
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# ต้องตรงกับ callback ที่อาจารย์ลงทะเบียนไว้ และ path ต้องเป็น /api/auth/callback
#   dev  : http://localhost:5173/api/auth/callback  (ให้ Vite proxy /api -> backend)
#   prod : https://fsg09.cpecmu.com/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
# เว็บ frontend ที่จะ redirect กลับไปหลังล็อกอินสำเร็จ
FRONTEND_URL=http://localhost:5173
# ค่าเริ่มต้นชี้ไป oauth497.cpecmu.com อยู่แล้ว ตั้งเฉพาะเมื่อต้องการเปลี่ยน
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_USERINFO_URL=
